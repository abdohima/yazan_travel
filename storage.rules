// Firebase Storage rules - only authenticated admins can upload; public read for images
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read to images for everyone
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email_verified == true;
    }
  }
}
